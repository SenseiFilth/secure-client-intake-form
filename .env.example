# Cloudflare Turnstile — bot protection
# Get these from https://dash.cloudflare.com/sign-up?to=/:account/turnstile
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Admin notification email (used with Resend or similar in production)
ADMIN_NOTIFICATION_EMAIL=

# Optional: set to "production" to enable strict security checks
NODE_ENV=development
